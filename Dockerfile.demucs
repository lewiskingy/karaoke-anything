FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ARG CONVTASNET_MODEL_REPO=cadenzachallenge/ConvTasNet_Lyrics_Causal
ARG CONVTASNET_MODEL_REVISION=main

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/app \
    TORCH_HOME=/models/torch \
    HF_HUB_DISABLE_TELEMETRY=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        ffmpeg \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-demucs.txt ./
RUN python3 -m pip install --break-system-packages --no-cache-dir -r requirements.txt \
    && python3 -m pip install --break-system-packages --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.7.1 \
        torchaudio==2.7.1 \
    && python3 -m pip install --break-system-packages --no-cache-dir -r requirements-demucs.txt

RUN mkdir -p /models/torch /models/convtasnet-lyrics-causal \
    && python3 -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='${CONVTASNET_MODEL_REPO}', revision='${CONVTASNET_MODEL_REVISION}', local_dir='/models/convtasnet-lyrics-causal')"

COPY app ./app

RUN python3 -c "from audio_trombone.vendor.clarity_tasnet import ConvTasNetStereo; model = ConvTasNetStereo.from_pretrained('/models/convtasnet-lyrics-causal', local_files_only=True); print('ConvTasNet model loaded', model.samplerate, model.audio_channels, model.C)"

EXPOSE 8080/tcp
EXPOSE 5004/udp

HEALTHCHECK --interval=15s --timeout=5s --start-period=180s --retries=5 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"

CMD ["python3", "app/main.py"]
