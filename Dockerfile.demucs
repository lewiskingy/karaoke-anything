FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ARG CONVTASNET_MODEL_REPO=cadenzachallenge/ConvTasNet_Lyrics_Causal
ARG CONVTASNET_MODEL_REVISION=main
ARG MDX23C_MODEL_REPO=Politrees/UVR_resources
ARG MDX23C_MODEL_REVISION=0472e5cd4e0f77b95ca2df7a8162992e6799fa49
# Upstream MDX23C implementation snapshot; override only with another reviewed commit.
ARG MDX23C_ARCH_REVISION=83d495dfc81b2ede9bc62f4209619f8bdfd14995

# CMAKE_POLICY_VERSION_MINIMUM works around CMake 4.x refusing to configure
# projects with an old `cmake_minimum_required` -- needed to build the vendored
# Opus C library pulled in by sphn (a demucs dependency) from source below.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/app \
    TORCH_HOME=/models/torch \
    HF_HUB_DISABLE_TELEMETRY=1 \
    CMAKE_POLICY_VERSION_MINIMUM=3.5

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        ffmpeg \
        curl \
        ca-certificates \
        build-essential \
    && rm -rf /var/lib/apt/lists/*
# build-essential (specifically a `cc` linker) is required to build the
# `sphn` wheel below: sphn has no prebuilt wheel for this platform, so pip
# builds it from source via maturin/pyo3, which auto-installs its own Rust
# toolchain but still needs a system C linker for the final link step.

# torch/torchaudio capped at 2.11.0: PyTorch stopped publishing cu128 wheels
# past that version (2.12+ moved to newer CUDA build targets), and this image
# is pinned to the cu128 CUDA 12.8 base. 2.11.0 fixes 7 of 8 known torch CVEs
# current at the time of writing; the remaining one (PYSEC-2025-194, fixed in
# 2.13.0) needs a CUDA base image bump to resolve -- a separate decision from
# a routine dependency bump.
COPY requirements.txt requirements-demucs.txt ./
RUN python3 -m pip install --break-system-packages --no-cache-dir -r requirements.txt \
    && python3 -m pip install --break-system-packages --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.11.0 \
        torchaudio==2.11.0 \
    && python3 -m pip install --break-system-packages --no-cache-dir -r requirements-demucs.txt

RUN mkdir -p /models/torch /models/convtasnet-lyrics-causal /models/mdx23c \
    && python3 -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='${CONVTASNET_MODEL_REPO}', revision='${CONVTASNET_MODEL_REVISION}', local_dir='/models/convtasnet-lyrics-causal')"

RUN python3 -c "from huggingface_hub import hf_hub_download; [hf_hub_download(repo_id='${MDX23C_MODEL_REPO}', revision='${MDX23C_MODEL_REVISION}', filename='MDX23C_models/' + name, local_dir='/models/mdx23c/.download') for name in ('MDX23C-8KFFT-InstVoc_HQ.ckpt', 'model_2_stem_full_band_8k.yaml')]" \
    && mv /models/mdx23c/.download/MDX23C_models/* /models/mdx23c/ \
    && rm -rf /models/mdx23c/.download

COPY app ./app

# Vendor only the architecture module used for construction, not the training repository.
RUN curl --fail --location --silent --show-error \
      "https://raw.githubusercontent.com/ZFTurbo/Music-Source-Separation-Training/${MDX23C_ARCH_REVISION}/models/mdx23c_tfc_tdf_v3.py" \
      --output app/audio_trombone/vendor/mdx23c_tfc_tdf_v3.py \
    && curl --fail --location --silent --show-error \
      "https://raw.githubusercontent.com/ZFTurbo/Music-Source-Separation-Training/${MDX23C_ARCH_REVISION}/LICENSE" \
      --output app/audio_trombone/vendor/LICENSE.music-source-separation-training \
    && python3 -m audio_trombone.tools.prepare_mdx23c_architecture \
      app/audio_trombone/vendor/mdx23c_tfc_tdf_v3.py

RUN python3 -c "from audio_trombone.vendor.clarity_tasnet import ConvTasNetStereo; model = ConvTasNetStereo.from_pretrained('/models/convtasnet-lyrics-causal', local_files_only=True); print('ConvTasNet model loaded', model.samplerate, model.audio_channels, model.C)"

RUN HF_HUB_OFFLINE=1 python3 -m audio_trombone.tools.validate_mdx23c

EXPOSE 8080/tcp
EXPOSE 5004/udp

HEALTHCHECK --interval=15s --timeout=5s --start-period=180s --retries=5 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"

CMD ["python3", "app/main.py"]
